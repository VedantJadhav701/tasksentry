# TaskSentry Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Storage
TASKSENTRY_DATABASE_PATH=tasksentry.db

# Logging
TASKSENTRY_LOG_LEVEL=INFO

# Ollama local inference endpoint
TASKSENTRY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: OpenAI-compatible real model endpoints (if using real cloud models)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Default pricing table override path
# TASKSENTRY_PRICING_FILE=configs/pricing.yaml
